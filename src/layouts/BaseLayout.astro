---
import '../styles/global.css';
import '../styles/brand-theme.css';

const {
  title = 'Eficiencia Energética Aplicada',
  description = 'Soluciones integrales de eficiencia energética para hogares, instituciones y empresas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffda00" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Eficiencia Energética Aplicada, inicio">
        <img class="brand-logo" src="/brand/logo-eea.png" alt="" width="58" height="58" />
        <span>eficiencia<br /><b>energética aplicada</b></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/soluciones/">Soluciones</a>
        <a href="/proyectos/">Proyectos</a>
        <a href="/#experiencia">Experiencia</a>
        <a href="/#contacto">Contacto</a>
      </nav>
      <a class="button button-small" href="/#contacto">Solicitar diagnóstico <span>↗</span></a>
    </header>
    <slot />
    <footer class="site-footer section-wrap">
      <a class="brand" href="/">
        <img class="brand-logo" src="/brand/logo-eea.png" alt="" width="66" height="66" loading="lazy" />
        <span>eficiencia<br /><b>energética aplicada</b></span>
      </a>
      <div><strong>Ing. Jorge Enrique Bernal Trujillo</strong><a href="tel:+573104893193">+57 310 489 3193</a><a href="mailto:jorgebernal1954@gmail.com">jorgebernal1954@gmail.com</a></div>
      <div><span>© {new Date().getFullYear()} Eficiencia Energética Aplicada S.A.S.</span><a href="#inicio">Volver arriba ↑</a></div>
    </footer>
  </body>
</html>
