---
import type { Project } from '../data/site';
const { project } = Astro.props as { project: Project };
---
<article class="project-card">
  <a class="project-image" href={`/proyectos/${project.slug}/`}>
    <img src={project.image} alt={`Instalación en ${project.name}`} loading="lazy" width="820" height="560" />
    <span>Ver ficha ↗</span>
  </a>
  <div class="project-meta"><span>{project.category}</span><span>{project.year}</span></div>
  <h3><a href={`/proyectos/${project.slug}/`}>{project.name}</a></h3>
  <p>{project.city} · {project.capacity}</p>
</article>
