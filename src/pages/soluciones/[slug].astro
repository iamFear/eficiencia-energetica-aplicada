---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { projects, services } from '../../data/site';
import ProjectCard from '../../components/ProjectCard.astro';

export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const currentIndex = services.findIndex(item => item.slug === service.slug);
const next = services[(currentIndex + 1) % services.length];
const relatedProjects = service.slug === 'piscinas-y-jacuzzis'
  ? projects.filter(project => project.category === 'Piscinas')
  : service.slug === 'calentadores-solares-de-agua'
    ? projects.filter(project => project.category !== 'Piscinas').slice(0, 3)
    : [];
const site = Astro.site ?? Astro.url;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Soluciones', item: new URL('/soluciones/', site).href },
      { '@type': 'ListItem', position: 3, name: service.title, item: Astro.url.href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.short,
    url: Astro.url.href,
    provider: { '@type': 'Organization', name: 'Eficiencia Energética Aplicada S.A.S.', url: new URL('/', site).href },
  },
];
---
<BaseLayout title={`${service.title} | Eficiencia Energética Aplicada`} description={service.short} image={service.image} preloadImage={service.image} structuredData={schema}>
  <main id="inicio">
    <section class="solution-detail-hero section-wrap">
      <a class="back-link" href="/soluciones/">← Todas las soluciones</a>
      <div><p class="eyebrow accent-dark">SOLUCIÓN {service.number}</p><h1>{service.title}</h1><p>{service.short}</p></div>
      <div class="solution-hero-image"><img src={service.image} alt={`Referencia visual de ${service.title}`} width="1240" height="1608" decoding="async" fetchpriority="high" /></div>
    </section>
    <section class="service-sections section-wrap">
      {service.sections.map(([title, text], index) => <article><span>{String(index + 1).padStart(2,'0')}</span><div><h2>{title}</h2><p>{text}</p></div></article>)}
      <p class="source-note">Información técnica basada en los documentos suministrados por Eficiencia Energética Aplicada. El desempeño y la viabilidad se determinan para cada proyecto.</p>
    </section>
    {service.slug === 'calentadores-solares-de-agua' && <section class="benefits section-wrap"><p class="eyebrow">VENTAJAS DOCUMENTADAS</p><div class="benefit-grid">{['Segura: sin combustión en el punto de captación','Disponible: no depende de cortes de combustible','Abundante: aprovecha un recurso presente en Colombia','Versátil: aplicable a obra nueva o existente','Limpia: evita emisiones directas durante la captación','Renovable: reduce el uso de fuentes fósiles'].map(item => <div>{item}</div>)}</div><p class="source-note">Las cifras históricas de retorno y desempeño contenidas en el brochure deben confirmarse mediante un estudio técnico y financiero actualizado.</p></section>}
    {relatedProjects.length > 0 && <section class="related section-wrap"><div class="section-heading"><div><h2>Proyectos donde se aplicó esta solución</h2></div><div><p>Ejemplos documentados en el portafolio histórico de la empresa.</p><a class="text-link" href="/proyectos/">Ver todos los proyectos <span aria-hidden="true">→</span></a></div></div><div class="project-grid">{relatedProjects.map(project => <ProjectCard project={project} />)}</div></section>}
    <section class="next-service section-wrap"><p>Siguiente solución</p><a href={`/soluciones/${next.slug}/`}><span>{next.number}</span>{next.title}<b>→</b></a></section>
    <ContactSection />
  </main>
</BaseLayout>
