---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, services, supplementaryProjects } from '../data/site';

const featuredProjects = [projects[4], projects[8], projects[0], projects[16], projects[14], projects[11]];
const site = Astro.site ?? Astro.url;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organizacion', site).href,
  name: 'Eficiencia Energética Aplicada S.A.S.',
  url: new URL('/', site).href,
  logo: new URL('/brand/logo-eea.png', site).href,
  email: 'jorgebernal1954@gmail.com',
  telephone: '+57 310 489 3193',
  description: 'Soluciones de energía solar, eficiencia energética, climatización y gestión del agua para viviendas e instituciones.',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'asesoría técnica',
    telephone: '+57 310 489 3193',
    email: 'jorgebernal1954@gmail.com',
    availableLanguage: 'Spanish',
  },
};
---

<BaseLayout title="Energía solar y eficiencia energética | Eficiencia Energética Aplicada" description="Soluciones de calentamiento solar de agua, bombas de calor y energía fotovoltaica para viviendas, hoteles, hospitales y piscinas. Consulte nuestro portafolio." preloadImage="/images/source/brochure-p01-01.webp" structuredData={organization}>
  <main id="inicio">
    <section class="hero hero-photo">
      <img src="/images/source/brochure-p01-01.webp" alt="Portafolio de sistemas solares térmicos de Eficiencia Energética Aplicada" width="1240" height="1608" decoding="async" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-copy section-wrap">
        <p class="eyebrow accent">INGENIERÍA · ENERGÍA · CONFORT</p>
        <h1>Mayor Ahorro<br />Más bienestar</h1>
        <p>Diseñamos soluciones para aprovechar el sol, reducir costos de operación y hacer más eficientes hogares, hoteles, hospitales, clínicas, piscinas, jacuzzis y proyectos inmobiliarios.</p>
        <div class="hero-actions">
          <a class="button button-accent" href="#contacto">Solicitar diagnóstico <span>↗</span></a>
          <a class="text-link light-link" href="/proyectos/">Explorar 18 proyectos <span>→</span></a>
        </div>
      </div>
      <div class="hero-proof section-wrap">
        <div><strong>1985–2013</strong><span>Años de trayectoria en instalaciones solares</span></div>
        <div><strong>18</strong><span>Proyectos con ficha técnica y fotografía</span></div>
        <div><strong>10+</strong><span>Ciudades con proyectos de distintas escalas</span></div>
      </div>
    </section>

    <section class="intro section-wrap" id="experiencia">
      <p class="eyebrow">EFICIENCIA ENERGÉTICA APLICADA</p>
      <div class="intro-grid">
        <h2>La solución correcta comienza por entender cómo se consume</h2>
        <div>
          <p>Integramos energía solar térmica y fotovoltaica, bombas de calor, iluminación eficiente, climatización, gestión de agua y criterios bioclimáticos. Cada propuesta parte de la demanda, las condiciones del lugar y la continuidad que necesita la operación.</p>
          <p class="authority"><b>Ing. Jorge Enrique Bernal Trujillo</b><br />Asesor en Eficiencia Energética</p>
        </div>
      </div>
    </section>

    <section class="solution-overview" id="soluciones">
      <div class="section-wrap">
        <div class="section-heading">
          <div><p class="eyebrow accent-dark">SOLUCIONES INTEGRALES</p><h2>Una estrategia completa para cada recurso</h2></div>
          <div><p>Desde agua caliente y electricidad hasta residuos, iluminación y confort térmico.</p><a class="text-link" href="/soluciones/">Ver todas las soluciones <span>↗</span></a></div>
        </div>
        <div class="service-list">
          {services.map((service) => (
            <a class="service-row" href={`/soluciones/${service.slug}/`}>
              <span>{service.number}</span><h3>{service.title}</h3><p>{service.short}</p><b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="solar-explainer section-wrap">
      <div class="explainer-image"><img src="/images/projects/edificio-ankara-bogota.webp" alt="Campo de colectores solares del Edificio Ankara en Bogotá" width="410" height="272" loading="lazy" decoding="async" /></div>
      <div class="explainer-copy">
        <p class="eyebrow">POR QUÉ ENERGÍA SOLAR TÉRMICA</p>
        <h2>El calor del sol trabaja todos los días</h2>
        <p>Para agua por debajo de 60 °C, la energía solar térmica puede atender duchas, cocina, lavandería, procesos institucionales y piscinas. Un sistema bien dimensionado acumula la energía disponible y combina respaldo solo cuando hace falta.</p>
        <ul class="check-list"><li>Fuente limpia, renovable y abundante</li><li>Sin costo de combustible solar</li><li>Compatible con bomba de calor o respaldo convencional</li><li>Aplicable en construcciones nuevas o existentes</li></ul>
        <a class="button" href="/soluciones/calentadores-solares-de-agua/">Entender el sistema <span>↗</span></a>
      </div>
    </section>

    <section class="comparison">
      <div class="section-wrap">
        <p class="eyebrow accent">COMPARACIÓN DE FUENTES DE CALOR</p>
        <h2>Elegir bien cambia el costo de toda la operación</h2>
        <div class="comparison-table" role="table" aria-label="Comparación de fuentes de calor">
          <div class="comparison-row comparison-head" role="row"><span role="columnheader">Criterio</span><b role="columnheader">Solar</b><b role="columnheader">Combustible Fósil</b><b role="columnheader">Electricidad</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Fuente</span><b role="cell">Sol</b><b role="cell">Combustible</b><b role="cell">Energía Eléctrica</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Costo del calor</span><b role="cell">Bajo en operación</b><b role="cell">Alto</b><b role="cell">Muy alto</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Emisiones directas de GEI</span><b role="cell">Cero</b><b role="cell">Altas</b><b role="cell">Dependientes de la red</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Obtención de calor</span><b role="cell">Gradual</b><b role="cell">Rápida</b><b role="cell">Media</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Almacenamiento requerido</span><b role="cell">Alto</b><b role="cell">Bajo</b><b role="cell">Medio</b></div>
          <div class="comparison-row" role="row"><span role="rowheader">Mantenimiento</span><b role="cell">Simple</b><b role="cell">Complejo</b><b role="cell">Bajo</b></div>
        </div>
      </div>
    </section>

    <section class="projects-home">
      <div class="section-wrap">
        <div class="section-heading">
          <div><p class="eyebrow">PORTAFOLIO</p><h2>Experiencia que se puede ver y medir</h2></div>
          <div><p>Proyectos hoteleros, hospitalarios, residenciales, educativos y deportivos.</p><a class="text-link" href="/proyectos/">Ver portafolio completo <span>→</span></a></div>
        </div>
        <div class="project-grid">{featuredProjects.map(project => <ProjectCard project={project} />)}</div>
      </div>
    </section>

    <section class="process section-wrap">
      <div><p class="eyebrow">MÉTODO DE TRABAJO</p><h2>De la necesidad a una solución</h2></div>
      <ol><li><span>01</span><div><h3>Diagnóstico</h3><p>Revisión de consumos, temperaturas, horarios, equipos existentes y condiciones del lugar.</p></div></li><li><span>02</span><div><h3>Diseño</h3><p>Selección tecnológica, dimensionamiento, respaldo y estimación de desempeño.</p></div></li><li><span>03</span><div><h3>Implementación</h3><p>Coordinación técnica para integrar los equipos con la infraestructura del proyecto.</p></div></li><li><span>04</span><div><h3>Operación</h3><p>Recomendaciones de uso y mantenimiento para conservar los ahorros y la calidad del servicio.</p></div></li></ol>
    </section>

    <section class="additional-projects section-wrap">
      <div><p class="eyebrow">MÁS PROYECTOS</p><h2>Otras instalaciones del portafolio</h2></div>
      <div class="simple-grid">{supplementaryProjects.map(project => <article><h3>{project.name}</h3><p>{project.note}</p></article>)}</div>
    </section>

    <ContactSection />
  </main>
</BaseLayout>
